{
  "apiVersion": 2,
  "id": "endfield-light",
  "name": "Endfield / Day Shift",
  "description": "Три стороны логотипа — три диапазона частот. Промышленная телеметрия Talos-II, глитчи и частицы.",
  "author": "Noctune Community",
  "version": "1.5.3",
  "width": 1920,
  "height": 1080,
  "preview": "preview",
  "palette": {
    "background": "#e9e8df",
    "accent": "#887400",
    "gradient": [
      "#e5ef42",
      "#a3b384",
      "#43bcbc"
    ]
  },
  "capabilities": {
    "visualizer": "bars",
    "visualizers": [
      "bars"
    ],
    "motion": true
  },
  "runtimeRequirements": {
    "dom": false
  },
  "quality": "balanced",
  "parameterSchema": {
    "amplitude": {
      "type": "slider",
      "label": "Высота спектра",
      "default": 1,
      "min": 0.2,
      "max": 2,
      "step": 0.1
    },
    "glitch": {
      "type": "slider",
      "label": "Глитч-эффекты",
      "default": 0.6,
      "min": 0,
      "max": 1,
      "step": 0.1
    },
    "particles": {
      "type": "toggle",
      "label": "Частицы",
      "default": true
    },
    "contours": {
      "type": "toggle",
      "label": "Топографические линии",
      "default": true
    },
    "scan": {
      "type": "toggle",
      "label": "Сканирующий луч",
      "default": true
    },
    "textFloat": {
      "type": "slider",
      "label": "Плавание текста",
      "default": 1,
      "min": 0,
      "max": 2,
      "step": 0.1
    },
    "parallax": {
      "type": "slider",
      "label": "Глубина параллакса",
      "default": 1,
      "min": 0,
      "max": 2,
      "step": 0.1
    },
    "animatedText": {
      "type": "toggle",
      "label": "Анимированная телеметрия",
      "default": true
    },
    "backgroundMotion": {
      "type": "slider",
      "label": "Движение фона",
      "default": 1,
      "min": 0,
      "max": 2,
      "step": 0.1
    }
  },
  "assets": {
    "logo": "assets/logo.png",
    "preview": "assets/preview.png"
  },
  "script": "scene.js"
}
