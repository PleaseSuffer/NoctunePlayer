{"format":"noctune-scene","apiVersion":2,"manifest":{"id":"echoes-of-neon","name":"Эхо неона · Echoes of Neon","description":"Dark ambient / vaporwave: одинокое солнце, тёмная вода, пульсация под музыку, неоновые отражения и деликатные VHS-глитчи.","author":"Noctune","version":"1.1.2","width":1920,"height":1080,"preview":"preview","palette":{"accent":"#c08cdd","background":"#090611","gradient":["#66b9c9","#ac78d4","#e890bf"]},"capabilities":{"visualizer":"line","visualizers":["line","bars","radial"],"motion":true},"parameters":{"frequencyMix":0.25,"glowIntensity":0.8},"apiVersion":2,"runtimeRequirements":{"dom":false},"parameterSchema":{"haloStrength":{"type":"slider","label":"Ореол и волны от солнца","default":0.8,"min":0,"max":1.5,"step":0.1},"shimmer":{"type":"slider","label":"Световые блики на воде","default":0.8,"min":0,"max":1.5,"step":0.1},"particles":{"type":"slider","label":"Светящаяся пыль","default":0.5,"min":0,"max":1,"step":0.1},"aberration":{"type":"slider","label":"Хроматическое расщепление глитчей","default":0.7,"min":0,"max":1,"step":0.1},"scanRoll":{"type":"toggle","label":"Бегущая VHS-полоса","default":true},"beatStrength":{"type":"slider","label":"Пульсация под бит","default":0.8,"min":0,"max":1.5,"step":0.1},"reflection":{"type":"slider","label":"Отражения в воде","default":0.45,"min":0,"max":0.8,"step":0.05},"waves":{"type":"slider","label":"Искажение отражений","default":3,"min":0,"max":8,"step":0.5},"glitch":{"type":"slider","label":"VHS-глитчи","default":0.3,"min":0,"max":1,"step":0.1},"grid":{"type":"toggle","label":"Ретро-сетка","default":true},"crt":{"type":"toggle","label":"CRT-текстура","default":true},"spectrumStyle":{"type":"select","label":"Спектр на горизонте","default":"line","options":[{"value":"line","label":"Неоновая линия"},{"value":"bars","label":"Столбики"},{"value":"hidden","label":"Скрыть"}]}},"quality":"balanced"},"assets":{"background":"data:image/png;base64,","preview":"data:image/png;base64,"},"script":"/// <reference path=\"../../sdk.d.ts\" />\n(() => {\n    'use strict';\n    const W = 1920, H = 1080, horizon = 572, sunX = 960, sunY = 456, sunR = 97;\n    let glitchLife = 0, cooldown = 0, glitchSeed = 0, previousPulse = 0, glitchClock = 0;\n    let glitchStep = 0, jitterClock = 0, nextGlitch = 1.4, glitchSurface = null;\n    const wavefronts = [];\n    const noise = n => { const v = Math.sin(n * 127.1 + 311.7) * 43758.5453; return v - Math.floor(v); };\n\n    function grid(api, beat, pixel) {\n        const c = api.ctx, t = api.time;\n        c.save(); c.beginPath(); c.rect(0, horizon + 1, W, H - horizon); c.clip();\n        c.lineWidth = 1.2 * pixel;\n        c.strokeStyle = '#b286d6'; c.globalAlpha = .29 + beat * .12;\n        c.beginPath();\n        for (let i = -14; i <= 14; i++) {\n            c.moveTo(sunX + i * 12, horizon); c.lineTo(sunX + i * 204, H);\n        }\n        for (let i = 0; i < 21; i++) {\n            const depth = ((i + t * .25) % 21) / 21;\n            const y = horizon + 10 * (Math.pow(51, depth) - 1);\n            c.moveTo(0, y); c.lineTo(W, y);\n        }\n        c.stroke(); c.restore();\n    }\n\n    function spectrum(api, source, style, beat) {\n        // Visible bounds keep the entire FFT edge to edge even with cover cropping.\n        const rect = api.visibleRect;\n        const options = { x: rect.x, y: horizon, width: rect.width,\n            height: 112 + beat * 60, source, opacity: .72 };\n        if (style === 'bars') api.bars(options);\n        else api.line({ ...options, fill: .14, reflection: false, hideWhenSilent: true });\n    }\n\n    function halo(api, source, amount, beat, energy) {\n        if (!amount) return;\n        const c = api.ctx;\n        c.save(); c.globalCompositeOperation = 'screen';\n        c.shadowColor = '#e291d8'; c.shadowBlur = 20 * api.glowIntensity;\n        c.lineWidth = 1.4; c.strokeStyle = '#e8a2d7';\n        c.globalAlpha = amount * (.14 + energy * .25 + beat * .35);\n        c.beginPath(); c.arc(sunX, sunY, sunR + 5 + beat * 12, 0, Math.PI * 2); c.stroke();\n        c.strokeStyle = '#77d7e0'; c.globalAlpha *= .45;\n        c.beginPath(); c.arc(sunX, sunY, sunR + 17 + beat * 20, 0, Math.PI * 2); c.stroke();\n        c.restore();\n        api.radialSpectrum({ x: sunX, y: sunY, radius: sunR + 7 + beat * 12,\n            height: 37 * amount, source, color: '#db99dd', opacity: .42 * amount, glow: 10 });\n        for (const wave of wavefronts) {\n            const progress = wave.age / 2.2;\n            c.save(); c.lineWidth = 1.2;\n            c.strokeStyle = '#bf8bdc'; c.shadowColor = '#bf8bdc'; c.shadowBlur = 12 * api.glowIntensity;\n            c.globalAlpha = (1 - progress) ** 2 * wave.strength * amount * .38;\n            c.beginPath(); c.arc(sunX, sunY, sunR + 14 + progress * 250, 0, Math.PI * 2); c.stroke();\n            c.restore();\n        }\n    }\n\n    function shimmer(api, amount, energy, beat) {\n        if (!amount) return;\n        const c = api.ctx;\n        c.save(); c.globalCompositeOperation = 'screen';\n        for (let i = 0; i < 32; i++) {\n            const depth = i / 32, y = horizon + 7 + depth * depth * 410;\n            const width = 38 + depth * 430;\n            const drift = Math.sin(api.time * .8 + i * 1.7) * (8 + depth * 26);\n            const g = c.createLinearGradient(sunX - width, 0, sunX + width, 0);\n            g.addColorStop(0, '#d18dcf00'); g.addColorStop(.5, i % 3 ? '#d18dcf' : '#73cbd8'); g.addColorStop(1, '#d18dcf00');\n            c.fillStyle = g;\n            c.globalAlpha = amount * (.025 + energy * .13 + beat * .12) * (1 - depth);\n            c.fillRect(sunX - width + drift, y, width * 2, 1 + depth * 2);\n        }\n        c.restore();\n    }\n\n    function particles(api, amount, energy) {\n        if (!amount) return;\n        const c = api.ctx;\n        c.save(); c.fillStyle = '#c8b7ed'; c.shadowColor = '#c8b7ed'; c.shadowBlur = 5 * api.glowIntensity;\n        for (let i = 0; i < 24; i++) {\n            const x = noise(i + 71) * W + Math.sin(api.time * .1 + i) * 15;\n            const y = (noise(i + 129) * horizon - api.time * (2 + noise(i) * 3) % horizon + horizon) % horizon;\n            c.globalAlpha = amount * (.07 + energy * .2) * (.5 + .5 * Math.sin(api.time * .5 + i));\n            c.fillRect(x, y, i % 4 ? 1 : 2, i % 4 ? 1 : 2);\n        }\n        c.restore();\n    }\n\n    function glitches(api, frame, amount, aberration) {\n        if (!frame.motion || frame.reducedMotion || !amount) {\n            glitchLife = glitchClock = jitterClock = 0; return;\n        }\n        glitchClock += api.dt;\n        cooldown = Math.max(0, cooldown - api.dt);\n        glitchLife = Math.max(0, glitchLife - api.dt);\n        const attack = frame.audio.playing && frame.audio.enabled && api.normalizedPulse > .1;\n        if (!cooldown && (attack || glitchClock >= nextGlitch)) {\n            glitchSeed++;\n            glitchLife = .2 + noise(glitchSeed + 91) * (.24 + amount * .16);\n            cooldown = glitchLife + .25 + noise(glitchSeed + 23) * (1.5 - amount);\n            nextGlitch = .8 + noise(glitchSeed + 57) * (4.2 - amount * 2);\n            glitchClock = 0;\n            glitchStep = 0; jitterClock = 0;\n        }\n        if (!glitchLife) return;\n        // Change the tear geometry throughout each burst, with irregular blank gaps.\n        // dt, rather than host/global time, preserves reset and reduced-motion behavior.\n        jitterClock -= api.dt;\n        if (jitterClock <= 0) {\n            glitchStep++;\n            jitterClock = .018 + noise(glitchSeed * 41 + glitchStep) * .042;\n        }\n        const seed = glitchSeed * 101 + glitchStep * 17;\n        if (noise(seed + 90) < .18) return;\n        const c = api.ctx, rect = api.visibleRect, pixel = rect.width / frame.width;\n        // Tear the current composition, including neon and grid, not a fixed PNG.\n        if (!glitchSurface) glitchSurface = api.createSurface(W, H);\n        const texture = glitchSurface.getContext('2d');\n        texture.clearRect(0, 0, W, H);\n        texture.drawImage(api.canvas, 0, 0, api.canvas.width, api.canvas.height,\n            rect.x, rect.y, rect.width, rect.height);\n        c.save();\n        c.imageSmoothingEnabled = false;\n        const mode = Math.floor(noise(seed + 6) * 4);\n        const count = 2 + Math.floor(noise(seed + 1) * (4 + amount * 6));\n        for (let i = 0; i < count; i++) {\n            const n = seed + i * 31;\n            const height = (mode === 1 ? 8 + noise(n + 2) * 32 : 1 + noise(n + 2) * 10) * pixel;\n            const y = Math.min(H - height, rect.y + noise(n + 3) * (rect.height - height));\n            const width = rect.width * (mode === 0 ? 1 : .12 + noise(n + 4) * .7);\n            const x = rect.x + noise(n + 5) * (rect.width - width);\n            const shift = (noise(n + 7) - .5) * (16 + 100 * amount) * pixel;\n            const lift = mode === 1 ? (noise(n + 8) - .5) * 12 * pixel : 0;\n            c.globalAlpha = .65 + noise(n + 9) * .3;\n            c.drawImage(glitchSurface, x, y, width, height, x + shift, y + lift, width, height);\n            c.globalCompositeOperation = 'screen';\n            c.globalAlpha = amount * aberration * (.1 + noise(n + 10) * .3);\n            c.fillStyle = i % 2 ? '#ef6dab' : '#54dae6';\n            c.fillRect(x - shift * .4, y + lift, width, pixel);\n            c.globalCompositeOperation = 'source-over';\n            if (mode >= 2) {\n                // Broken tape/dropout speckles travel with each new jitter sample.\n                for (let j = 0; j < 12; j++) {\n                    c.globalAlpha = .1 + noise(n + j + 11) * .24;\n                    c.fillStyle = j % 3 ? '#cbb9da' : '#10091b';\n                    c.fillRect(x + noise(n + j * 7) * width, y + noise(n + j * 9) * height,\n                        (2 + noise(n + j * 13) * 23) * pixel, pixel);\n                }\n            }\n        }\n        c.restore();\n    }\n\n    function crt(api, pixel, gridEnabled) {\n        const c = api.ctx, rect = api.visibleRect;\n        // Do not place a fixed scan raster underneath the moving water grid either:\n        // translucent antialiased edges would still reveal alternating dark rows.\n        const bottom = gridEnabled ? Math.min(horizon, rect.y + rect.height) : rect.y + rect.height;\n        const fade = y => gridEnabled ? Math.max(0, Math.min(1, (horizon - y) / (24 * pixel))) : 1;\n        c.save(); c.fillStyle = '#020108';\n        for (let y = rect.y; y < bottom; y += 3 * pixel) {\n            c.globalAlpha = .4 * fade(y);\n            c.fillRect(rect.x, y, rect.width, pixel);\n        }\n        c.fillStyle = '#b18ad3';\n        for (let y = rect.y + pixel; y < bottom; y += 6 * pixel) {\n            c.globalAlpha = .045 * fade(y);\n            c.fillRect(rect.x, y, rect.width, pixel);\n        }\n        c.restore();\n    }\n\n    NoctuneScene.define({\n        reset() {\n            glitchLife = cooldown = glitchSeed = previousPulse = glitchClock = glitchStep = jitterClock = 0;\n            nextGlitch = 1.4; wavefronts.length = 0;\n        },\n        dispose(api) { if (glitchSurface) api.releaseSurface(glitchSurface); glitchSurface = null; },\n        render(api, frame) {\n            const p = frame.parameters, c = api.ctx;\n            // Logical pixels per viewport CSS pixel, including cover cropping.\n            const pixel = api.visibleRect.width / frame.width;\n            const beat = Math.min(1, api.normalizedPulse) * p.beatStrength;\n            const energy = api.energy * p.beatStrength;\n            const source = api.bandsSource({ count: 128, minHz: 35, maxHz: 14000,\n                spacing: 'hybrid', attack: 20, release: 5, smoothing: .5 });\n            const ringSource = api.bandsSource({ count: 64, minHz: 60, maxHz: 8000,\n                spacing: 'log', attack: 18, release: 6, smoothing: .6 });\n            if (frame.motion && !frame.reducedMotion) {\n                for (let i = wavefronts.length - 1; i >= 0; i--) {\n                    wavefronts[i].age += api.dt;\n                    if (wavefronts[i].age >= 2.2) wavefronts.splice(i, 1);\n                }\n                if (api.normalizedPulse > .3 && previousPulse <= .3 && wavefronts.length < 4 && frame.audio.playing && frame.audio.enabled)\n                    wavefronts.push({ age: 0, strength: Math.min(1, beat) });\n            }\n            previousPulse = api.normalizedPulse;\n            api.layer('background');\n            // Rasterize only the background. A moving thin grid crossing a second\n            // high-frequency raster creates a beat/moiré pattern and visible flicker.\n            if (p.crt) crt(api, pixel, p.grid);\n            api.light(sunX, sunY, 350 + beat * 110, .04 + energy * .18 + beat * .22, '#b75bbf');\n            api.light(sunX, horizon, 600, energy * .09 + beat * .09, '#6860c9');\n            if (p.grid) grid(api, beat, pixel);\n            const upper = () => {\n                halo(api, ringSource, p.haloStrength, beat, energy);\n                if (p.spectrumStyle !== 'hidden') spectrum(api, source, p.spectrumStyle, beat);\n            };\n            upper();\n            if (p.reflection > 0) api.reflection({ baseline: horizon + 2, height: 440,\n                opacity: p.reflection, distortion: p.waves * (1 + beat), strips: 64 }, upper);\n            shimmer(api, p.shimmer, energy, beat);\n            particles(api, p.particles, energy);\n            c.save();\n            const rect = api.visibleRect, rim = c.createLinearGradient(rect.x, 0, rect.x + rect.width, 0);\n            rim.addColorStop(0, '#6ec6dd'); rim.addColorStop(.5, '#d995db'); rim.addColorStop(1, '#8975d7');\n            c.strokeStyle = rim; c.lineWidth = 1; c.globalAlpha = .19 + beat * .22;\n            c.shadowColor = '#c48bd9'; c.shadowBlur = (12 + beat * 10) * api.glowIntensity;\n            c.beginPath(); c.moveTo(rect.x, horizon); c.lineTo(rect.x + rect.width, horizon); c.stroke();\n            c.restore();\n            if (p.reflection > 0) api.waterRipple({ x: sunX, y: 690, radius: 330,\n                strength: .4 + energy + beat, opacity: p.reflection * .24, color: '#ab78c5', rings: 4, speed: .5 });\n            glitches(api, frame, p.glitch, p.aberration);\n            c.save();\n            if (p.scanRoll) {\n                const y = api.time * 26 % (H + 140) - 140;\n                const scan = c.createLinearGradient(0, y, 0, y + 140);\n                scan.addColorStop(0, '#b197de00'); scan.addColorStop(.7, '#b197de'); scan.addColorStop(1, '#b197de00');\n                c.globalAlpha = .028; c.fillStyle = scan; c.fillRect(0, y, W, 140);\n            }\n            const shade = c.createLinearGradient(0, 780, 0, H);\n            shade.addColorStop(0, '#09061100'); shade.addColorStop(1, '#09061175');\n            c.globalAlpha = 1; c.fillStyle = shade; c.fillRect(0, 780, W, 300);\n            c.restore();\n        }\n    });\n})();\r\n"}