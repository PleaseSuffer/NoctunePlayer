{"format":"noctune-scene","apiVersion":2,"manifest":{"id":"api-v2-demo","name":"Scene API v2 Demo","description":"Общий спектр за PNG-силуэтами, отражение воды и типизированные настройки","author":"Noctune","version":"1.0.0","width":640,"height":360,"preview":"preview","palette":{"accent":"#b699ef","background":"#101425","gradient":["#73bdd5","#aa87e0","#edbfa0"]},"capabilities":{"visualizer":"bars","visualizers":["bars","line","radial"],"motion":true},"parameters":{"frequencyMix":0.6,"glowIntensity":1},"apiVersion":2,"runtimeRequirements":{"dom":false},"parameterSchema":{"waves":{"type":"slider","label":{"ru":"Сила волн","en":"Wave strength"},"default":2,"min":0,"max":8,"step":0.5},"crown":{"type":"toggle","label":{"ru":"Круговой спектр","en":"Radial spectrum"},"default":true},"style":{"type":"select","label":{"ru":"Визуализатор","en":"Visualizer"},"default":"bars","options":[{"value":"bars","label":"Столбики"},{"value":"line","label":"Линия"}]}},"quality":"balanced"},"assets":{"preview":"data:image/png;base64,","towers":"data:image/png;base64,","water":"data:image/png;base64,"},"script":"/// <reference path=\"../../sdk.d.ts\" />\nNoctuneScene.define({\n    render(api, frame) {\n        const source = api.bandsSource({ count: 80, minHz: 35, maxHz: 18000, attack: 18, release: 7, smoothing: .35 });\n        const visualizer = () => {\n            const options = { x: 40, y: 250, width: 560, height: 110, source, opacity: .85 };\n            if (frame.parameters.style === 'line') api.line({ ...options, hideWhenSilent: true });\n            else api.bars(options);\n        };\n        api.compose({\n            background() {\n                const c = api.ctx, gradient = c.createLinearGradient(0, 0, 0, 360);\n                gradient.addColorStop(0, '#101425'); gradient.addColorStop(1, '#34305a');\n                c.fillStyle = gradient; c.fillRect(0, 0, 640, 360);\n                api.shootingStars({ color: '#d9d2ff', opacity: .6, glow: 10, stop: 'freeze' });\n            },\n            effects() {\n                api.clipMask('towers', visualizer, { invert: true });\n                api.reflection({ baseline: 260, height: 100, mask: 'water', distortion: Number(frame.parameters.waves), opacity: .4 }, visualizer);\n                if (frame.parameters.crown) api.radialSpectrum({ x: 320, y: 115, radius: 40, height: 35, source });\n                api.clipMask('water', () => api.waterRipple({ x: 450, y: 310, radius: 100, opacity: .15 }));\n            },\n            foreground() { api.layer('towers'); },\n        });\n    },\n});\n"}