{"format":"noctune-scene","apiVersion":1,"manifest":{"id":"05-obsessed-over-camera","name":"Ноктилия • Одержимость","description":"Взгляд без моргания, свечение глаз и контура под бит. Дыхание и движение волос на тёмном фоне.","author":"Noctune","version":"1.0.0","width":1672,"height":941,"preview":"preview","palette":{"accent":"#b699ef","background":"#0b0d1b","gradient":["#6865ad","#b78ced","#dfaece"]},"capabilities":{"visualizer":"character","motion":true},"parameters":{"frequencyMix":0.75,"glowIntensity":1}},"assets":{"background":"data:image/png;base64,","character":"data:image/png;base64,","preview":"data:image/png;base64,"},"script":"NoctuneScene.define({\n    render(api) {\n        api.layer('background');\n        const c = api.ctx, shade = c.createLinearGradient(0, 0, api.width, api.height);\n        shade.addColorStop(0, '#080914dd'); shade.addColorStop(.65, '#1e153b55'); shade.addColorStop(1, '#070911bb');\n        c.fillStyle = shade; c.fillRect(0, 0, api.width, api.height);\n        api.flicker([[1422,423,25,'#d6c8ff',.10],[1494,397,22,'#b7daff',.10],[1450,480,24,'#e2c3f8',.10],[1562,391,20,'#f2bbdd',.10],[1598,443,25,'#c9bcff',.10],[1623,480,22,'#f1c9e8',.10],[1270,268,85,'#ab9aff',.05]]);\n        api.light(1000, 320, 560, api.energy * .08 + api.pulse * .14);\n        api.character('character', { anchor: 930, hairY: [0, 580], contour: true, eyeGlow: [[883, 339, 32], [1018, 244, 32]] });\n    },\n});\n"}