{
  "id": "noctune-shades",
  "name": "Noctune Shades",
  "description": "extension.description",
  "author": "Noctune",
  "version": "1.0.1",
  "revision": 3,
  "apiVersion": 2,
  "minNoctuneVersion": "1.4.0",
  "type": "extension",
  "entry": "main.js",
  "icon": "assets/icon.png",
  "banner": "assets/banner.png",
  "homepage": "https://github.com/PleaseSuffer/NoctunePlayer",
  "permissions": [
    "settings.read",
    "settings.events",
    "appearance.register",
    "appearance.switch"
  ],
  "commands": [
    {
      "id": "apply-selected",
      "title": "commands.applySelected.title"
    },
    {
      "id": "release-colors",
      "title": "commands.releaseColors.title"
    }
  ],
  "settings": {
    "scheme": {
      "type": "select",
      "label": "settings.scheme.label",
      "default": "graphite",
      "options": [
        {
          "value": "graphite",
          "label": "settings.scheme.options.graphite"
        },
        {
          "value": "slate",
          "label": "settings.scheme.options.slate"
        },
        {
          "value": "cocoa",
          "label": "settings.scheme.options.cocoa"
        },
        {
          "value": "ivory",
          "label": "settings.scheme.options.ivory"
        },
        {
          "value": "mist",
          "label": "settings.scheme.options.mist"
        },
        {
          "value": "rose",
          "label": "settings.scheme.options.rose"
        }
      ]
    },
    "keepAccent": {
      "type": "toggle",
      "label": "settings.keepAccent.label",
      "default": false,
      "description": "settings.keepAccent.description"
    },
    "applySelected": {
      "type": "toggle",
      "label": "settings.applySelected.label",
      "default": true,
      "description": "settings.applySelected.description"
    }
  },
  "localization": {
    "defaultLocale": "ru",
    "files": {
      "ru": "locales/ru_RU.json",
      "en": "locales/en_US.json"
    }
  }
}
