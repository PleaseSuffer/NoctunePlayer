{
  "id": "noctune-chroma",
  "name": "Noctune Chroma",
  "description": "extension.description",
  "author": "Noctune",
  "version": "1.0.1",
  "revision": 3,
  "apiVersion": 2,
  "minNoctuneVersion": "1.4.0",
  "type": "extension",
  "entry": "main.js",
  "icon": "assets/icon.png",
  "banner": "assets/banner.png",
  "homepage": "https://github.com/PleaseSuffer/NoctunePlayer",
  "permissions": [
    "settings.read",
    "settings.events",
    "themes.accent",
    "notifications.show"
  ],
  "commands": [
    {
      "id": "restart-cycle",
      "title": "commands.restartCycle.title"
    },
    {
      "id": "check-palette",
      "title": "commands.checkPalette.title"
    }
  ],
  "settings": {
    "animated": {
      "type": "toggle",
      "label": "settings.animated.label",
      "description": "settings.animated.description",
      "default": true
    },
    "mode": {
      "type": "select",
      "label": "settings.mode.label",
      "default": "rainbow",
      "options": [
        {
          "value": "rainbow",
          "label": "settings.mode.options.rainbow"
        },
        {
          "value": "aurora",
          "label": "settings.mode.options.aurora"
        },
        {
          "value": "sunset",
          "label": "settings.mode.options.sunset"
        },
        {
          "value": "ocean",
          "label": "settings.mode.options.ocean"
        },
        {
          "value": "neon",
          "label": "settings.mode.options.neon"
        },
        {
          "value": "custom",
          "label": "settings.mode.options.custom"
        }
      ]
    },
    "colors": {
      "type": "text",
      "label": "settings.colors.label",
      "description": "settings.colors.description",
      "default": "#ff6b9d, #a78bfa, #38bdf8",
      "maxLength": 160
    },
    "duration": {
      "type": "slider",
      "label": "settings.duration.label",
      "description": "settings.duration.description",
      "min": 6,
      "max": 300,
      "step": 1,
      "default": 45
    },
    "direction": {
      "type": "select",
      "label": "settings.direction.label",
      "default": "forward",
      "options": [
        {
          "value": "forward",
          "label": "settings.direction.options.forward"
        },
        {
          "value": "reverse",
          "label": "settings.direction.options.reverse"
        },
        {
          "value": "bounce",
          "label": "settings.direction.options.bounce"
        }
      ]
    },
    "easing": {
      "type": "select",
      "label": "settings.easing.label",
      "description": "settings.easing.description",
      "default": "smooth",
      "options": [
        {
          "value": "smooth",
          "label": "settings.easing.options.smooth"
        },
        {
          "value": "linear",
          "label": "settings.easing.options.linear"
        }
      ]
    },
    "saturation": {
      "type": "slider",
      "label": "settings.saturation.label",
      "description": "settings.saturation.description",
      "min": 20,
      "max": 100,
      "step": 1,
      "default": 85
    },
    "brightness": {
      "type": "slider",
      "label": "settings.brightness.label",
      "min": 35,
      "max": 100,
      "step": 1,
      "default": 100
    },
    "offset": {
      "type": "slider",
      "label": "settings.offset.label",
      "description": "settings.offset.description",
      "min": 0,
      "max": 359,
      "step": 1,
      "default": 210
    },
    "quality": {
      "type": "select",
      "label": "settings.quality.label",
      "default": "20",
      "options": [
        {
          "value": "20",
          "label": "settings.quality.options.smooth"
        },
        {
          "value": "10",
          "label": "settings.quality.options.economical"
        }
      ]
    }
  },
  "localization": {
    "defaultLocale": "ru",
    "files": {
      "ru": "locales/ru_RU.json",
      "en": "locales/en_US.json"
    }
  }
}
