{
  "id": "noctune-sleep",
  "name": "Noctune Sleep",
  "description": "extension.description",
  "author": "Noctune",
  "version": "1.0.1",
  "revision": 3,
  "apiVersion": 2,
  "minNoctuneVersion": "1.4.0",
  "type": "extension",
  "entry": "main.js",
  "icon": "assets/icon.png",
  "banner": "assets/banner.png",
  "homepage": "https://github.com/PleaseSuffer/NoctunePlayer",
  "permissions": [
    "settings.read",
    "settings.events",
    "playback.pause",
    "audio.gain",
    "notifications.show",
    "hotkeys.register"
  ],
  "commands": [
    {
      "id": "start-timer",
      "title": "commands.startTimer.title"
    },
    {
      "id": "cancel-timer",
      "title": "commands.cancelTimer.title"
    },
    {
      "id": "extend-timer",
      "title": "commands.extendTimer.title"
    },
    {
      "id": "time-left",
      "title": "commands.timeLeft.title"
    }
  ],
  "settings": {
    "minutes": {
      "type": "slider",
      "label": "settings.minutes.label",
      "default": 30,
      "min": 5,
      "max": 180,
      "step": 5,
      "description": "settings.minutes.description"
    },
    "fade": {
      "type": "toggle",
      "label": "settings.fade.label",
      "default": true
    },
    "fadeSeconds": {
      "type": "slider",
      "label": "settings.fadeSeconds.label",
      "default": 20,
      "min": 5,
      "max": 60,
      "step": 5,
      "visibleWhen": {
        "field": "fade",
        "equals": true
      }
    },
    "startOnEnable": {
      "type": "toggle",
      "label": "settings.startOnEnable.label",
      "default": false,
      "description": "settings.startOnEnable.description"
    }
  },
  "localization": {
    "defaultLocale": "ru",
    "files": {
      "ru": "locales/ru_RU.json",
      "en": "locales/en_US.json"
    }
  }
}
