{
  "id": "noctune-dusk",
  "name": "Noctune Dusk",
  "description": "extension.description",
  "author": "Noctune",
  "version": "1.0.1",
  "revision": 3,
  "apiVersion": 2,
  "minNoctuneVersion": "1.4.0",
  "type": "extension",
  "entry": "main.js",
  "icon": "assets/icon.png",
  "banner": "assets/banner.png",
  "homepage": "https://github.com/PleaseSuffer/NoctunePlayer",
  "permissions": [
    "settings.read",
    "settings.events",
    "appearance.list",
    "appearance.select",
    "appearance.events",
    "backgrounds.list",
    "backgrounds.override",
    "notifications.show"
  ],
  "commands": [
    {
      "id": "apply-now",
      "title": "commands.applyNow.title"
    },
    {
      "id": "schedule-status",
      "title": "commands.scheduleStatus.title"
    }
  ],
  "settings": {
    "automatic": {
      "type": "toggle",
      "label": "settings.automatic.label",
      "default": true
    },
    "dayStart": {
      "type": "text",
      "label": "settings.dayStart.label",
      "default": "07:00",
      "maxLength": 5
    },
    "nightStart": {
      "type": "text",
      "label": "settings.nightStart.label",
      "default": "21:00",
      "maxLength": 5
    },
    "dayTheme": {
      "type": "select",
      "label": "settings.dayTheme.label",
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": "settings.dayTheme.options.light"
        },
        {
          "value": "dark",
          "label": "settings.dayTheme.options.dark"
        },
        {
          "value": "system",
          "label": "settings.dayTheme.options.system"
        }
      ],
      "source": "appearance.schemes",
      "description": "settings.dayTheme.description"
    },
    "nightTheme": {
      "type": "select",
      "label": "settings.nightTheme.label",
      "default": "dark",
      "options": [
        {
          "value": "light",
          "label": "settings.dayTheme.options.light"
        },
        {
          "value": "dark",
          "label": "settings.dayTheme.options.dark"
        },
        {
          "value": "system",
          "label": "settings.dayTheme.options.system"
        }
      ],
      "source": "appearance.schemes"
    },
    "wallpapers": {
      "type": "toggle",
      "label": "settings.wallpapers.label",
      "default": false
    },
    "dayWallpaper": {
      "type": "select",
      "label": "settings.dayWallpaper.label",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "settings.dayWallpaper.options.keepCurrent"
        }
      ],
      "source": "backgrounds",
      "visibleWhen": {
        "field": "wallpapers",
        "equals": true
      }
    },
    "nightWallpaper": {
      "type": "select",
      "label": "settings.nightWallpaper.label",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "settings.dayWallpaper.options.keepCurrent"
        }
      ],
      "source": "backgrounds",
      "visibleWhen": {
        "field": "wallpapers",
        "equals": true
      }
    }
  },
  "localization": {
    "defaultLocale": "ru",
    "files": {
      "ru": "locales/ru_RU.json",
      "en": "locales/en_US.json"
    }
  }
}
