{"files":{"README.md":"# Noctune Shades\n\nОфициальное расширение Noctune · версия 1.0.0 · SDK 1 · Noctune 1.4.0.\n\nШесть спокойных цветовых схем для интерфейса: тёмные **Графит**, **Сланец**,\n**Какао** и светлые **Слоновая кость**, **Туман**, **Пудра**. Палитры включают\nфон, панели, основной и вторичный текст, границы, наведение и акцент.\n\n## Установка и настройки\n\nУстановите подписанный `.noctaddon` через «Настройки → Расширения» и включите его.\nВыберите палитру в **Цветовая схема**. Изменения применяются сразу.\n\n- **Сохранять собственный акцент** — оставить акцент плеера вместо акцента палитры.\n  Акцент Chroma сохраняет свой приоритет.\n- **Применять выбранную схему** — выключите, если Shades должен только\n  предоставлять схемы другим расширениям, например Dusk.\n- **Применить выбранную схему** — команда ручного применения.\n- **Вернуть оформление плеера** — снять собственное оформление до следующей\n  смены настройки или повторного ручного применения.\n\nВсе шесть схем появляются в разделе «Внешний вид» и в списках Dusk, пока Shades\nвключён. Для расписания включите Shades, при желании отключите автоматическое\nприменение в его настройках и выберите дневную и ночную палитры в Dusk.\n\nИзменения временные. Отключение Shades снимает его оформление и убирает схемы\nиз доступного списка. Если на схему ссылался Dusk, он перейдёт на соответствующее\nвстроенное оформление и восстановит выбранную схему после включения Shades.\nНастройки пользователя не перезаписываются.\n\n## Разрешения\n\n- `settings.read`, `settings.events` — выбранная палитра и поведение акцента.\n- `appearance.register` — предоставить шесть схем плееру и другим расширениям.\n- `appearance.switch` — применять и снимать собственную палитру.\n\nРасширение не использует сеть, файлы, аудио и данные о треках.\n\n## Обновления и подпись\n\nОбновления устанавливаются новым подписанным пакетом. Официальность проверяется\nключом Noctune, встроенным в плеер; публичная идентичность опубликована в\n`addons/official/publisher.json`. Канал автоматических обновлений для этого пакета\nне объявлен. Лицензия: MIT, см. `license.txt`.\n","assets/banner.png":{"data":"","encoding":"base64"},"assets/icon.png":{"data":"","encoding":"base64"},"license.txt":"﻿Лицензия MIT (MIT License)\n\nАвторское право (c) 2026 lifeisafelony\n\nДанная лицензия разрешает лицам, получившим копию данного программного обеспечения и сопутствующей документации (в дальнейшем именуемыми «Программное обеспечение»), безвозмездно использовать Программное обеспечение без ограничений, включая права на использование, копирование, изменение, слияние, публикацию, распространение, сублицензирование и/или продажу копий Программного обеспечения, а также право разрешать лицам, которым предоставляется Программное обеспечение, делать это при соблюдении следующего условия:\n\nУказанное выше уведомление об авторском праве и данное разрешение должны быть включены во все копии или значительные части Программного обеспечения.\n\nПРОГРАММНОЕ ОБЕСПЕЧЕНИЕ ПРЕДОСТАВЛЯЕТСЯ «КАК ЕСТЬ», БЕЗ КАКИХ-ЛИБО ГАРАНТИЙ, ВЫРАЖЕННЫХ ИЛИ ПОДРАЗУМЕВАЕМЫХ, ВКЛЮЧАЯ, НО НЕ ОГРАНИЧИВАЯСЬ ГАРАНТИЯМИ ТОВАРНОЙ ПРИГОДНОСТИ, СООТВЕТСТВИЯ ОПРЕДЕЛЕННОМУ НАЗНАЧЕНИЮ И ОТСУТСТВИЯ НАРУШЕНИЙ. НИ В КОЕМ СЛУЧАЕ АВТОРЫ ИЛИ ПРАВООБЛАДАТЕЛИ НЕ НЕСУТ ОТВЕТСТВЕННОСТИ ЗА ЛЮБЫЕ ПРЕТЕНЗИИ, УБЫТКИ ИЛИ ИНЫЕ ТРЕБОВАНИЯ, БУДЬ ТО В РЕЗУЛЬТАТЕ ДЕЙСТВИЯ ДОГОВОРА, ДЕЛИКТА ИЛИ ИНЫМ ОБРАЗОМ, ВОЗНИКАЮЩИЕ ИЗ, В СВЯЗИ С ПРОГРАММНЫМ ОБЕСПЕЧЕНИЕМ ИЛИ ИСПОЛЬЗОВАНИЕМ ДАННОГО ПРОГРАММНОГО ОБЕСПЕЧЕНИЯ.","main.js":"/* Noctune Shades · official Noctune extension · MIT */\nNoctuneAddon.define(async api => {\n    const schemes = [\n        ['graphite','Графит','dark',['#1b1b20','#26262d','#f2f2f5','#aaaab6','#3b3b45','#32323b','#a9a9be','#c9bddf']],\n        ['slate','Сланец','dark',['#18212c','#243140','#eef4fc','#a8b8cd','#3a4a60','#2c3b4e','#7db5e8','#b9a7e7']],\n        ['cocoa','Какао','dark',['#261e1c','#352925','#f6eee8','#c4ada0','#544039','#41322c','#dfb08b','#e7c5ab']],\n        ['ivory','Слоновая кость','light',['#f5f0e7','#fffaf2','#37332d','#766b5b','#dbd1c1','#eae1d4','#9b6f44','#80575c']],\n        ['mist','Туман','light',['#edf1f5','#fbfcfe','#2c3643','#657488','#ced7e2','#e1e8f0','#537daa','#78669d']],\n        ['rose','Пудра','light',['#f7edef','#fff9fa','#44333a','#876873','#e7cfd7','#efdee4','#ad637e','#91628f']],\n    ];\n    const roles = ['background','surface','text','muted','border','hover','accent','secondary'];\n    let settings = await api.settings.get(), work = Promise.resolve();\n    const serialize = action => { const result=work.then(action);work=result.catch(()=>{});return result; };\n    async function register() {\n        for (const [id,name,mode,colors] of schemes) {\n            const palette = Object.fromEntries(roles.filter(role=>role!=='accent'||!settings.keepAccent).map(role=>[role,colors[roles.indexOf(role)]]));\n            await api.appearance.register({id,name,mode,palette});\n        }\n    }\n    async function apply() { await api.appearance.switch({id:settings.applySelected?settings.scheme:null}); }\n    api.on('settings.changed',event=>serialize(async()=>{\n        const registerAgain=settings.keepAccent!==event.values.keepAccent; settings=event.values;\n        if(registerAgain)await register(); await apply();\n    }));\n    api.onCommand('apply-selected',()=>serialize(()=>api.appearance.switch({id:settings.scheme})));\n    api.onCommand('release-colors',()=>serialize(()=>api.appearance.switch({id:null})));\n    await register(); await apply();\n});\n"},"format":"noctune-addon","formatVersion":1,"manifest":{"apiVersion":1,"author":"Noctune","banner":"assets/banner.png","commands":[{"id":"apply-selected","title":"Применить выбранную схему"},{"id":"release-colors","title":"Вернуть оформление плеера"}],"description":"Спокойные цветовые схемы: графит, сланец, какао и три светлые палитры. Официальное расширение Noctune.","entry":"main.js","homepage":"https://github.com/PleaseSuffer/NoctunePlayer","icon":"assets/icon.png","id":"noctune-shades","minNoctuneVersion":"1.4.0","name":"Noctune Shades","permissions":["settings.read","settings.events","appearance.register","appearance.switch"],"revision":1,"settings":{"applySelected":{"default":true,"description":"Отключите, чтобы только предоставлять схемы для Dusk и выбора во внешнем виде.","label":"Применять выбранную схему","type":"toggle"},"keepAccent":{"default":false,"description":"Использовать акцент из настроек плеера; Chroma сохраняет приоритет своего акцента.","label":"Сохранять собственный акцент","type":"toggle"},"scheme":{"default":"graphite","label":"Цветовая схема","options":[{"label":"Графит","value":"graphite"},{"label":"Сланец","value":"slate"},{"label":"Какао","value":"cocoa"},{"label":"Слоновая кость","value":"ivory"},{"label":"Туман","value":"mist"},{"label":"Пудра","value":"rose"}],"type":"select"}},"type":"extension","version":"1.0.0"},"signature":{"algorithm":"Ed25519","publicKey":"MCowBQYDK2VwAyEALAJFDBWRORrLn6rkC4Wgmwk2PftibnEPWwpyvPWq2es=","value":"rEubIOCWtLitfA5yAK5glEARvn3OvHLClXQ4cF+K5IaqH4a297PmVBA9ZS41oJvsrYQAdFVNSKJ/kLm3MxQYCg=="}}