{
  "name": "noctune",
  "displayName": "Noctune",
  "productName": "Noctune",
  "version": "1.2.0",
  "main": "src/main.js",
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  },
  "author": "Telegram: @borisik_denis",
  "description": "Noctune: Lightweight music player",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "keywords": [],
  "license": "MIT",
  "type": "commonjs",
  "build": {
    "appId": "com.noctune.player",
    "productName": "Noctune",
    "files": [
      "src/**/*",
      "resources/app.ico",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/app.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false,
      "shortcutName": "Noctune",
      "installerSidebar": "resources/logo.bmp",
      "uninstallerSidebar": "resources/logo.bmp",
      "unicode": true,
      "license": "LICENSE"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "PleaseSuffer",
        "repo": "NoctunePlayer",
        "vPrefixedTagName": false
      }
    ]
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.3.9",
    "lucide": "^1.17.0",
    "music-metadata": "^11.0.0"
  }
}
