{
  "name": "Noctune",
  "version": "1.1.3",
  "main": "src/main.js",
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  },
  "author": "Telegram: @borisik_denis",
  "description": "Noctune: Lightweight music player",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "keywords": [],
  "license": "MIT",
  "type": "commonjs",
  "build": {
    "appId": "com.noctune.player",
    "win": {
      "target": "nsis",
      "icon": "resources/app.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false,
      "shortcutName": "Noctune",
      "installerSidebar": "resources/logo.bmp",
      "uninstallerSidebar": "resources/logo.bmp",
      "unicode": true,
      "license": "LICENSE"
    }
  },
  "dependencies": {
    "electron-store": "^11.0.2"
  }
}
