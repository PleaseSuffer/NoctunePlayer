{
  "name": "noctune",
  "displayName": "Noctune",
  "productName": "Noctune",
  "desktopName": "com.noctune.player.desktop",
  "version": "1.4.0",
  "main": "src/main/index.js",
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  },
  "author": "Telegram: @borisik_denis",
  "description": "Noctune: Lightweight music player",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "node tests/run.cjs",
    "audit:package": "node scripts/audit-package.cjs"
  },
  "keywords": [],
  "license": "MIT",
  "type": "commonjs",
  "build": {
    "appId": "com.noctune.player",
    "productName": "Noctune",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "src/main/**/*.js",
      "src/preload/**/*.js",
      "src/renderer/**/*.{js,html,css}",
      "src/shared/**/*.{js,css}",
      "addons/catalog/official.json",
      "themes/builtin/**/{manifest.json,scene.js}",
      "themes/builtin/**/assets/**/*.{png,jpg,jpeg,webp}",
      "themes/backgrounds/*.{png,jpg,jpeg,webp,json}",
      "resources/app.ico",
      "resources/app.png",
      "LICENSE",
      "package.json",
      "!.development{,/**/*}",
      "!**/AGENTS{,.override}.md",
      "!**/*.{map,ts,tsx,mts,cts,tsbuildinfo}",
      "!**/!(LICENSE*|LICENCE*|license*|licence*|COPYING*|copying*|NOTICE*|notice*|THIRD_PARTY_LICENSE*|ThirdPartyNotices*).{md,markdown}",
      "!node_modules/**/{docs,doc,examples,example,test,tests,__tests__,coverage,benchmark,benchmarks,scripts}/**/*",
      "!node_modules/lucide/dist/{cjs,esm}/**/*",
      "!node_modules/lucide/dist/umd/lucide.js"
    ],
    "linux": {
      "fileAssociations": [
        {
          "ext": "noctheme",
          "name": "Noctune Theme",
          "description": "Noctune theme",
          "mimeType": "application/x-noctune-theme"
        }
      ],
      "target": [
        "AppImage",
        "pacman",
        "tar.gz"
      ],
      "icon": "resources/app.png",
      "category": "AudioVideo;Audio;Player",
      "syncDesktopName": true,
      "executableArgs": [
        "%F"
      ],
      "mimeTypes": [
        "application/x-noctune-theme"
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "resources/app.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "include": "resources/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false,
      "shortcutName": "Noctune",
      "installerSidebar": "resources/logo.bmp",
      "uninstallerSidebar": "resources/logo.bmp",
      "unicode": true,
      "license": "LICENSE"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "PleaseSuffer",
        "repo": "NoctunePlayer",
        "vPrefixedTagName": false
      }
    ]
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.3.9",
    "lucide": "^1.17.0",
    "music-metadata": "^11.0.0"
  }
}
